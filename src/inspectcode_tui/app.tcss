/* InspectCode TUI v2.0 - Horizontal Split Layout */

Screen {
    layout: vertical;
}

#main-container {
    height: 1fr;
    layout: horizontal;
}

#left-panel {
    width: 60%;
    height: 1fr;
    layout: vertical;
}

#findings-table {
    height: 1fr;
}

#scan-log {
    height: 12;
    min-height: 5;
    max-height: 30;
    border-top: solid $accent;
    display: block;
}

#scan-log.hidden {
    display: none;
}

#right-panel {
    width: 40%;
    height: 1fr;
    layout: vertical;
}

#code-file-label {
    height: auto;
    max-height: 3;
    padding: 0 1;
    background: $accent;
    color: $text;
    text-style: bold;
}

#code-display {
    height: 1fr;
}

#summary {
    height: auto;
}
